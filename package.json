{
  "name": "dsh-vigil",
  "version": "0.0.2",
  "description": "Install-time risk audit, runtime deletion sentinel, local quarantine, optional Sage engine with auto-provision/update, live-saving settings, session-independent install audits, and a modal approval flow for dangerous operations in DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "src",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "threats",
    "icon.svg",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check client.js && node --test test/",
    "verify": "node --test test/"
  }
}
